# PostHog 配置（可选）
# 在 https://posthog.com 创建项目后，将 Project API Key 填入下方
# 未配置时，事件仍会记录在页面右侧的本地事件面板中

POSTHOG_KEY=phc_your_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Kafka OAuth（可选，来自 Surveyor CLIENT_CONFIGS + Console Access Key）
# 1. 从 Surveyor 下载 kafka-ca.crt 和 oauth-ca.crt 到 config/kafka/
# 2. 在 Console API Explorer 创建 Access Key，填入 client id/secret
# 3. 启用后，浏览器事件会通过 POST /api/events 写入 Kafka

KAFKA_ENABLED=false
KAFKA_TOPIC=datapulse-events
KAFKA_BOOTSTRAP_SERVERS=csm-bp-kafka.cldr-csk-csm-1.a70735.test.cldr.work:8443
KAFKA_TOKEN_URL=https://console.readygo.a70735.test.cldr.work/api/v0/auth/access-keys/token
KAFKA_CONFIG_DIR=config/kafka
KAFKA_CLIENT_ID=
KAFKA_CLIENT_SECRET=
# KAFKA_HOME 由 cai-start-application.sh 自动下载；本地测试可手动指定
# KAFKA_HOME=/path/to/kafka_2.13-3.9.0
