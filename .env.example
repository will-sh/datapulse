# PostHog configuration (optional)
# After creating a project at https://posthog.com, paste the Project API Key below.
# Without it, events still appear in the local event panel on the right side of the page.

POSTHOG_KEY=phc_your_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Kafka OAuth (optional — from Surveyor CLIENT_CONFIGS + Console Access Key)
# 1. Download kafka-ca.crt and oauth-ca.crt from Surveyor into config/kafka/
# 2. Create an Access Key in Console API Explorer
# 3. When enabled, browser events are written to Kafka via POST /api/events

KAFKA_ENABLED=false
KAFKA_TOPIC=datapulse-events
KAFKA_BOOTSTRAP_SERVERS=csm-bp-kafka.cldr-csk-csm-1.a70735.test.cldr.work:8443
KAFKA_TOKEN_URL=https://console.readygo.a70735.test.cldr.work/api/v0/auth/access-keys/token
KAFKA_CONFIG_DIR=config/kafka
KAFKA_CLIENT_ID=
KAFKA_CLIENT_SECRET=
# KAFKA_HOME is auto-downloaded by cai-start-application.sh when KAFKA_ENABLED=true; set manually for local testing
# KAFKA_HOME=/path/to/kafka_2.13-3.9.0
